# Copy to .env and fill in for local/manual runs (docker-compose.yml sets
# most of these itself for the containerized flow).

DB_URL=jdbc:postgresql://localhost:5432/hs_notification
DB_USERNAME=hs_notify
DB_PASSWORD=changeme

SMTP_HOST=subex-com.mail.protection.outlook.com
SMTP_PORT=25
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=support.alerts@subex.com

SERVER_PORT=8089

# Comma-separated TENANTCODE:apikey pairs. Replace before any real deployment -
# see Milestone 2 in CLAUDE_CODE_PROMPT.md for moving this to a hashed DB table.
HS_NOTIFICATION_SECURITY_API_KEYS=SUBEX:dev-local-key-change-me

# CASE_WATCH_TENANT_CODE should match the tenant above (SUBEX by default)
CASE_WATCH_TENANT_CODE=SUBEX

# Frontend (Vite) - must match one of the keys above
VITE_API_KEY=dev-local-key-change-me

# Usage DB - separate Postgres holding system_pr_results_<catalog_id> tables
# (PR-records CSV export). Blank/unset = feature gracefully no-ops.
USAGE_DB_URL=jdbc:postgresql://CHANGEME-HOST:5432/CHANGEME-DBNAME
USAGE_DB_USERNAME=CHANGEME
USAGE_DB_PASSWORD=CHANGEME

# case_tbl DB - separate Postgres holding HyperSense's case_tbl (case-watch
# poller). Blank/unset = poller stays disabled/no-op. Also requires
# CASE_WATCH_ENABLED=true and CASE_WATCH_TENANT_CODE to actually run.
#CASE_TBL_DB_URL=jdbc:postgresql://CHANGEME-HOST:5432/CHANGEME-DBNAME
#CASE_TBL_DB_USERNAME=CHANGEME
#CASE_TBL_DB_PASSWORD=CHANGEME

# User directory DB - separate Postgres holding a HyperSense username->email
# mirror (see HS_NOTIFICATION_V2_METADATA_DESIGN.md). Blank/unset = internal
# recipient resolution falls back to username+"@"+CASE_WATCH_OWNER_EMAIL_DOMAIN
# synthesis for every username.
#USER_DIRECTORY_DB_URL=jdbc:postgresql://CHANGEME-HOST:5432/CHANGEME-DBNAME
#USER_DIRECTORY_DB_USERNAME=CHANGEME
#USER_DIRECTORY_DB_PASSWORD=CHANGEME
