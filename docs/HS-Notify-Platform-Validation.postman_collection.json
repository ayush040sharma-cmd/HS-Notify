    {
      "name": "09 Attachment Upload (manual — attach a file before sending)",
      "item": [
        {
          "name": "Upload Attachment",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/v1/attachments", "host": ["{{baseUrl}}"], "path": ["api","v1","attachments"] },
            "body": { "mode": "formdata", "formdata": [ { "key": "file", "type": "file", "src": [] } ] }
          },
          "description": "Postman can't embed binary file contents in a JSON collection export — open this request, go to Body, and pick a local file for the 'file' field before sending. Returns a path usable as attachmentReportIdentifier on a rule (attachmentType=UPLOAD)."
        }
      ]
    }
